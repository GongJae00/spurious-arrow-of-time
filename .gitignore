# Local environments and Python caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Local-only manuscript workspace
paper/

# Generated experiment artifacts: paper result JSON under results/main,
# results/ablation, and results/reviewer is versioned; per-epoch curves,
# scratch plots, and logs are not.
results/**
!results/
!results/main/
!results/main/**
!results/ablation/
!results/ablation/**
!results/reviewer/
!results/reviewer/**
results/**/epoch_metrics.jsonl
results/**/diagnostics.json
results/**/summary.md
*.pt
*.pth
*.ckpt

# Large binary sources: raw clips and preprocessed caches are rebuilt via
# python -m src.data from data/real_video/urls.json.
data/real_video/*.webm
data/real_video/*.npz

# Runtime/editor noise
*.log
logs/
tmp/
smoke_tmp*/
